[Unit]
Description=中国地下偶像档案管理服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idol-console
Group=idol-console
WorkingDirectory=/srv/china-underground-idol/console/current
ExecStart=/usr/bin/node /srv/china-underground-idol/console/current/server.mjs serve --data-dir /var/lib/idol-console --key-file /etc/idol-console/master.key --admin-dir /srv/china-underground-idol/console/current/public --site-dir /srv/china-underground-idol/current --geo-dir /srv/china-underground-idol/console/geo --origin https://idol.hi-veblen.com --port 8788
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
Environment=NODE_ENV=production
Environment=TZ=Asia/Shanghai
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH NODE_OPTIONS BASH_ENV ENV IDOL_ADMIN_PASSWORD
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/idol-console
# 绑定稳定父目录；公开 current 在同一进程内跟随发布和回滚。
ReadOnlyPaths=/srv/china-underground-idol /etc/idol-console/master.key
LimitCORE=0
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
