{
  "name": "china-underground-idol-map",
  "private": true,
  "scripts": {
    "test": "npm run test:legacy && node scripts/test.mjs",
    "test:legacy": "node tests/accessibility-contract.mjs && node tests/public-reviewed-records.mjs && node --check app.js && node --check data.js",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "preview": "node scripts/preview.mjs",
    "preview:console": "node scripts/localConsole.mjs",
    "maintain:local": "node maintenance/localEditorial.mjs",
    "package:site": "npm run verify && node scripts/packageSite.mjs",
    "build:console": "node scripts/buildConsole.mjs",
    "test:console": "node scripts/testConsole.mjs",
    "verify:console": "npm run typecheck && node scripts/checkConsole.mjs && npm run build:console && npm run test:console",
    "package:console": "npm run verify:console && node scripts/packageConsole.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "ip2region.js": "3.1.8"
  }
}
